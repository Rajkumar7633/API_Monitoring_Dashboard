# Server port — Render sets this automatically in production
PORT=3001

# Node environment
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Production URLs
# ─────────────────────────────────────────────────────────────

# Render backend (Express API server)
BACKEND_URL=https://api-monitoring-backend-yuwr.onrender.com

# Vercel frontend URL (set on Render dashboard as FRONTEND_URL)
FRONTEND_URL=http://localhost:3000

# Default backend credentials
BACKEND_USERNAME=admin
BACKEND_PASSWORD=admin123
