# Server port — Render sets this automatically in production
PORT=3001

# Node environment
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Set these in your Vercel / Render dashboard for production:
#
#  On Vercel (frontend):
#    BACKEND_URL = https://<your-render-app>.onrender.com
#    NEXT_PUBLIC_API_URL = (leave blank — uses same-origin API routes)
#    BACKEND_USERNAME = admin
#    BACKEND_PASSWORD = admin123
#
#  On Render (backend):
#    FRONTEND_URL = https://<your-vercel-app>.vercel.app
#    PORT = (set automatically by Render — do NOT override)
# ─────────────────────────────────────────────────────────────

# Local development only
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
